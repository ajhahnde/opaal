import './report.opaal' as report
import project::context as project
import std::filesystem as fs
import std::data as data
export { summarize }

action summarize() -> Record
effects {
    filesystem.write(project::evidence);
}
{
    let result = report::build()
    fs::write_atomic(project::evidence, data::json_encode(result))
    return result
}
task summarize = summarize
