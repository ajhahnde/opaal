
import std::value

enum Selection[T] {
    Selected(T),
    Empty,
}

def tail[T](items: List[T]) -> Selection[List[T]]
{
    match items {
        [] => { return Selection::Empty }
        [first, ...rest] => { return Selection::Selected(rest) }
    }
}

def outcome(passed: Bool) -> String
{
    let report = {label: if passed {
        "pass"
    } else {
        "fail"
    }}
    return report.label
}

if outcome(true) != "pass" {
    throw "unexpected selection"
}

match tail(["build", "test", "review"]) {
    Selection::Selected(rest) => { value::length(rest) }
    Selection::Empty => { 0 }
}
