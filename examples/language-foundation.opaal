
import std::value

enum Selection[T] {
    Selected(T),
    Empty,
}

def tail[T](items: List[T]) -> Selection[List[T]]
{
    match items {
        [] => { return Selection::Empty }
        [first, ...rest] => { return Selection::Selected(rest) }
    }
}

def outcome(passed: Bool) -> String
{
    let report = {label: if passed {
        "pass"
    } else {
        "fail"
    }}
    return report.label
}

if outcome(true) != "pass" {
    throw "unexpected selection"
}

def summary(passed: Bool) -> (Int, String)
{
    return (3, outcome(passed))
}

let (count, label) = summary(true)
if count != 3 || label != "pass" {
    throw "unexpected summary"
}

let rows = [(40, "build"), (50, "test")]
mut indexed_total = 0
for index, (number, _) in rows {
    indexed_total += index + number
}
mut test_total = 0
for (number, name) in rows {
    if name == "test" {
        test_total += number
    }
}
if indexed_total != 91 || test_total != 50 {
    throw "unexpected loop result"
}

match tail(["build", "test", "review"]) {
    Selection::Selected(rest) => { value::length(rest) }
    Selection::Empty => { 0 }
}
