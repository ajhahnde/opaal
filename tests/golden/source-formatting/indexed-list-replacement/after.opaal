import std::value::{length}
def replace_middle() -> Int
{
    mut statuses: List[String] = ["ok", "pending", "ok"]
    let previous = statuses
    statuses[1] = "ok"
    if statuses == ["ok", "ok", "ok"] && previous[1] == "pending" {
        return length(statuses) - 2
    }
    return 0
}
export {test_value}
def test_value() -> Bool
{
    return replace_middle() == 1
}
