import './policy.opaal' as policy
import std::data as data
import std::io as io
mut report = {}
try {
    let saved: Record = data::json_decode(io::read_stdin(1048576))
    report = policy::checked(saved.code, saved.findings, saved.manifest)
} catch error {
    throw "Saved repository input failed."
}
io::write_stdout(data::json_encode(report))
if !report.passed {
    exit 1
}
exit 0
