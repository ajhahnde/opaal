import std::io as io
import std::string as string
export { run }

action run() -> Null
effects {
    stdin.read();
    stdout.write();
    stderr.write();
}
{
    let input = io::read_stdin(4096)
    let text = string::decode_utf8(input)
    io::print(text)
    io::eprintln("processed")
    return null
}
task sample = run
