import './assess.opaal' as assess
import std::data as data
import std::io as io
export { run }

action run() -> Record
effects {
    stdin.read();
    stdout.write();
    stderr.write();
}
{
    let input = io::read_stdin(65536)
    let result = assess::evaluate(data::json_decode(input))
    io::write_stdout(data::json_encode(result))
    return result
}
task sample = run
